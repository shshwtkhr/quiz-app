# Origin of the Express backend, as seen from the Next.js server.
# Browser traffic always calls the same-origin /api path, which next.config.ts
# rewrites to this origin — so this never needs to be reachable from the browser,
# only from wherever the Next.js server runs.
#   local dev:  http://localhost:5000
#   docker:     http://backend:5000
BACKEND_ORIGIN=http://localhost:5000

# Legacy direct-call base URL. Only used for server-side rendering when
# BACKEND_ORIGIN is unset; safe to omit.
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
